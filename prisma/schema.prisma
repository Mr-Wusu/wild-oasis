

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}



model User {
  id    String @id @default(cuid())
  email String @unique
  emailVerified Boolean   @default(false)
  name String
  firstname String
  surname String
  role          Role      @default(USER)
  sessions      Session[]
  accounts      Account[]
  cabin Cabin?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image         String?
  @@map("users")
  @@index([email])

}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?   
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Cabin {
  id String @id @default(cuid())
  discount Int
  name String @unique
  maxCapacity Int
  numGuard Int
  image String
  userid String? @unique
  regularPrice Int
  description String
  bookings Booking[]
  guest User?  @relation(fields: [userid], references: [id], onDelete: SetNull)
  
  @@map("cabins")
  @@index([name])
}

model Booking {
  id         String   @id @default(cuid())
  cabinId    String
  cabin      Cabin    @relation(fields: [cabinId], references: [id], onDelete: Cascade)
  guestName  String
  email      String
  numGuests  Int
  totalPrice Float
  startDate  DateTime
  endDate    DateTime
  isPaid     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("bookings")
  @@index([cabinId])
  @@index([startDate, endDate])
}

model Settings {
  id                  String   @id @default(cuid())
  key                 String @unique @default("default")
  minBookingLength    Int   @default(1)
  maxBookingLength    Int   @default(90)
  maxGuestsPerBooking Int   @default(10)
  breakfastPrice      Float @default(15)

  @@map("settings")
}


enum Role {
  ADMIN
  TEST_ADMIN
  USER
}
